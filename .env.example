# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — used by the Waffo webhook to update profiles (never expose it)
SUPABASE_SERVICE_ROLE_KEY=

# Waffo payments (required for checkout)
# Dashboard > API & Development > "Create an API Key" section
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
# Dashboard > Products — the $4.99/month subscription product (PROD_xxx)
WAFFO_PRODUCT_ID=
# Dashboard > Settings > Store Profile — used by the customer portal and webhook store check (STO_xxx)
WAFFO_STORE_ID=

# Optional: used by `npm run waffo:setup` to register the webhook
# WAFFO_WEBHOOK_URL=https://YOUR_DOMAIN/api/webhooks/waffo
# WAFFO_WEBHOOK_TEST_MODE=false
# Public site origin (also used by the setup script)
NEXT_PUBLIC_APP_URL=

# Optional: override the embedded Waffo webhook public keys if they are rotated
# WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
# WAFFO_WEBHOOK_TEST_PUBLIC_KEY=

# OpenRouter — powers the homework solver (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional override; the model must accept image and file input
OPENROUTER_MODEL=google/gemini-3.5-flash
