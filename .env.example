# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Waffo payments (optional until checkout is configured)
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRODUCT_ID=

# OpenRouter — powers the homework solver (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional override; the model must accept image and file input
OPENROUTER_MODEL=google/gemini-3.5-flash
